# FreeLinX/ports - devel/libgc : Boehm-Demers-Weiser GC (8.2.8).
#
# Conservative garbage collector. Required by w3m.
# BSD-style license. Autotools build.

NAME    := libgc
VERSION := 8.2.8
CATEGORY:= devel
LICENSE := BSD-3-Clause
DEPENDENCIES:=
BUILD_DEPENDENCIES:= musl (via FreeLinX toolchain sysroot)
TARGET  := $(FREELINX_TRIPLE)
PREFIX  := /

INSTALL_RELPATH:= usr/lib

include ../../mk/project-port.mk

SRC_TREE = $(FREELINX_BUILD_DIR)/work/$(NAME)/bdwgc-$(VERSION)
PROJECT_BIN = $(SRC_TREE)/.libs/libgc.a

OPENSSL_PREFIX = $(FREELINX_BUILD_DIR)/deps/openssl

PROJECT_CFG_CMDS = \
	cd "$(SRC_TREE)" && \
	if [ ! -f configure ]; then \
		autoreconf -fi 2>/dev/null || true; \
	fi && \
	./configure \
		--host=$(FREELINX_TRIPLE) \
		--prefix=/usr \
		--enable-static \
		--disable-shared \
		--disable-cplusplus \
		--disable-gcj-support \
		--disable-java-support \
		--disable-sigsetjmp \
		--without-pic \
		CC="$(FREELINX_CC)" \
		CFLAGS="$(FREELINX_TARGET_FLAGS) $(FREELINX_SYSROOT_FLAGS) $(FREELINX_RESOURCE_FLAGS) -O2" \
		LDFLAGS="$(FREELINX_TARGET_FLAGS) $(FREELINX_SYSROOT_FLAGS) $(FREELINX_RESOURCE_FLAGS) -static -fuse-ld=lld --rtlib=compiler-rt"

BUILD_CMDS = \
	cd "$(SRC_TREE)" && \
	make -j"$(FREELINX_JOBS)" all

.PHONY: install
install: all
	@mkdir -p "$(STAGE_ROOT)/usr/lib"
	@$(INSTALL) -m 644 "$(SRC_TREE)/.libs/libgc.a" "$(STAGE_ROOT)/usr/lib/libgc.a"
# The headers come from include/, not include/gc/.  bdwgc 8.2.8 has
#
#   include/gc.h  include/gc_mark.h  include/gc_version.h
#   include/extra/gc.h
#
# and no include/gc/ directory at all, so the paths below used to say
#
#   install: cannot stat '.../bdwgc-8.2.8/include/gc/gc.h': No such file or directory
#
# after the archive had already been staged.  They are staged flat under
# usr/include because that is how a consumer spells them: www/w3m says
# #include <gc.h>.
#
# The glob is gc*.h and not *.h on purpose.  bdwgc's own include/ directory
# holds a config.h, and staging it next to a consumer's headers means a consumer
# that puts -I/usr/include first compiles against bdwgc's configuration instead
# of its own.  Every public header is named gc-something (see pkginclude_HEADERS
# in include/include.am), so gc*.h is the whole public surface and not config.h.
#
# It is a glob rather than the three headers a first pass staged, because gc.h has
# local includes that have to come with it:
#
#   #include "gc_version.h"
#   #include "gc_config_macros.h"
#
# gc_config_macros.h is generated by configure from gc_config_macros.h.in, and
# without it configure reports
#
#   configure: WARNING: gc.h: present but cannot be compiled
#   configure: WARNING: gc.h:     check for missing prerequisite headers?
#   ...
#   configure: error: gc.h not found
#
# which reads as a missing header when the header is right there and one line
# short.  The directory is copied rather than the list of files in it, because
# what gc.h includes is bdwgc's business and not this port's.
	@mkdir -p "$(STAGE_ROOT)/usr/include"
	rm -f "$(STAGE_ROOT)/usr/include/gc"*.h
	$(INSTALL) -m 644 "$(SRC_TREE)/include/"gc*.h "$(STAGE_ROOT)/usr/include/"
	@printf '[FreeLinX/ports] staged libgc\n'
