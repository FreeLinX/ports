--- a/Modules/_ssl.c
+++ b/Modules/_ssl.c
@@ -70,7 +70,14 @@
 #include "openssl/dh.h"
 
 #ifndef OPENSSL_THREADS
-#  error "OPENSSL_THREADS is not defined, Python requires thread-safe OpenSSL"
+/* FreeLinX: the OpenSSL staged under build/deps by this tree is a
+ * no-threads build, so a hard error here makes _ssl and _hashlib
+ * unbuildable.  Downgraded to a warning: single-threaded use is
+ * correct, but concurrent TLS/hashing from several threads shares
+ * a lock-free libcrypto.  Rebuilding the tree openssl with threads
+ * would remove this caveat (and this patch).
+ */
+#  warning "OPENSSL_THREADS is not defined, Python requires thread-safe OpenSSL"
 #endif
 
 
