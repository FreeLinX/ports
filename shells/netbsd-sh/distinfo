# FreeLinX/ports - shells/netbsd-sh : upstream source reference.
#
# UPSTREAM SOURCE (not FreeLinX patches, not generated):
#   NetBSD 10.1 `/bin/sh` -- the Almquist shell (ash) used by NetBSD.
#
#   In the NetBSD source tree it lives at bin/sh (the external/bsd/bin/sh
#   path is from older releases; the port's do-prepare makes both resolve to
#   the same directory).
#
#   It is fetched as part of the full NetBSD base src set:
#       https://cdn.netbsd.org/pub/NetBSD/NetBSD-10.1/source/sets/src.tgz
#   which contains bin/, usr.bin/, lib/ etc., including bin/sh and the
#   sources sh pulls in from bin/test, bin/kill and usr.bin/printf.
#
# The NetBSD 10.1 release src set is immutable and reproducible. See
# https://www.netbsd.org/releases/formal-10/NetBSD-10.1.html and
# https://cdn.netbsd.org/pub/NetBSD/NetBSD-10.1/source/sets/SHA512 for the
# release checksums published by the NetBSD project.
#
# Relevant sh sources under that tree:
#   bin/sh/{alias.c, arithmetic.c, cd.c, error.c, eval.c, exec.c, expand.c,
#     histedit.c, input.c, jobs.c, main.c, memalloc.c, miscbltin.c,
#     mystring.c, options.c, output.c, parser.c, redir.c, show.c, syntax.c,
#     trap.c, var.c, ...}
#   bin/sh/bltin/echo.c, bin/test/test.c, bin/kill/kill.c,
#   usr.bin/printf/printf.c
#
# NOTE: the port builds the "small" shell (-DSMALL): no libedit/history.
DISTINFO_NAME=netbsd-10.1-src
DISTINFO_ARCHIVE=src.tgz
DISTINFO_URL=https://cdn.netbsd.org/pub/NetBSD/NetBSD-10.1/source/sets/src.tgz
