+/*
+ * DTR control.
+ *
+ * NetBSD has TIOCCDTR and TIOCSDTR: ioctls that read and set the Data Terminal
+ * Ready line of a serial port.  Linux has no equivalent.  The tty subsystem
+ * there exposes modem status lines (MSR_DCTS/MSR_DDSR/MSR_DCD) for reading,
+ * but there is no request that drives DTR, because a Linux serial port has no
+ * user-writable DTR - the line is driven by the driver and by carrier detect.
+ *
+ * Inventing two request numbers to keep the source compiling would be a lie
+ * that failed silently, so the calls are routed through one function whose
+ * body says plainly what Linux cannot do.  The only behaviour lost is the
+ * courtesy hang-up: dropping DTR is how this driver ends a call, and without it
+ * the modem has to be hung up with the AT command escape (the "+++" sequence
+ * the comment above describes), which tip(1) does not send.
+ *
+ * Every call site's return value was already discarded - each was
+ * `(void)ioctl(...)' - so nothing that depended on the result is changed.
+ */
+static void
+hay_dtr(int on)
+{
+#ifdef TIOCCDTR
+	(void)ioctl(FD, on ? TIOCSDTR : TIOCCDTR, 0);
+#else
+	(void)on;			/* no DTR control on Linux */
+#endif
+}
