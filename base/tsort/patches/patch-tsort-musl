+/* FreeLinX: musl lacks NetBSD libutil erealloc(3)/emalloc(3)/ecalloc(3).
+ * Provide local equivalents (err(1) on failure, matching NetBSD). */
+static void *emalloc(size_t n) {
+	void *p = malloc(n);
+	if (p == NULL)
+		err(1, NULL);
+	return p;
+}
+static void *ecalloc(size_t n, size_t s) {
+	void *p = calloc(n, s);
+	if (p == NULL)
+		err(1, NULL);
+	return p;
+}
+static void *erealloc(void *p, size_t n) {
+	p = realloc(p, n);
+	if (p == NULL)
+		err(1, NULL);
+	return p;
+}
 
