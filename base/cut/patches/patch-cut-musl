+#ifndef __unused
+#define __unused __attribute__((__unused__))
+#endif
+static void *erealloc(void *p, size_t n) {
+	p = realloc(p, n);
+	if (p == NULL)
+		err(1, NULL);
+	return p;
+}
+static void *ecalloc(size_t n, size_t s) {
+	void *p = calloc(n, s);
+	if (p == NULL)
+		err(1, NULL);
+	return p;
+}
